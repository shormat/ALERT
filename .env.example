# ── Kaggle API ────────────────────────────────────────────────────────────────
# Required for: scripts/download_kaggle_*.py
#
# How to get:
#   1. Log in at https://www.kaggle.com
#   2. Go to https://www.kaggle.com/settings → API → "Create New Token"
#   3. kaggle.json is downloaded — copy username and key below
#
# Note: if ~/.kaggle/kaggle.json already exists, leave these blank.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Dataset roots ─────────────────────────────────────────────────────────────
# Override where raw datasets and processed outputs live. Useful when:
#   - your data lives on a different disk / NAS / scratch volume
#   - running on a cluster (e.g. /scratch/users/$USER/alert)
#   - sharing data between multiple checkouts of the repo
#
# Defaults (used when unset or blank): <repo>/data/raw and <repo>/data/processed.
# Paths can be absolute or relative to the repo root; ~ is expanded.
DATA_RAW_ROOT=
DATA_PROCESSED_ROOT=

# ── Output root ───────────────────────────────────────────────────────────────
# Where pipeline videos, eval results, and logs are written.
# Default (when unset or blank): <repo>/outputs
# On a shared cluster, point this to /scratch/users/$USER/alert/outputs
OUTPUT_ROOT=

# ── Weights & Biases ──────────────────────────────────────────────────────────
# Training scripts log metrics/artifacts to wandb (projects:
# alert-detection, alert-segmentation).
#
# Auth — pick one:
#   (A) Interactive (recommended for personal machines):
#         uv run wandb login         # caches the key in ~/.netrc
#   (B) Non-interactive (servers / SLURM): set WANDB_API_KEY below.
#       Get it from https://wandb.ai/authorize
#
# Mode override (optional):
#   WANDB_MODE=online   — default; pushes live to wandb.ai
#   WANDB_MODE=offline  — write to disk; sync later with `wandb sync <dir>`
#                         (use when compute nodes have no outbound internet)
#   WANDB_MODE=disabled — skip wandb entirely (quick local debug runs)
WANDB_API_KEY=
WANDB_MODE=
# Team or username that owns the wandb projects (empty = your default entity)
WANDB_ENTITY=
